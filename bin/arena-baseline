#!/usr/bin/env ruby
require_relative "../config/boot"
require_relative "../lib/arena_baseline/manifest"

unless [["verify"], ["bootstrap"]].include?(ARGV)
  abort "Refusing baseline command: use verify or bootstrap without extra arguments"
end

begin
  manifest = ArenaBaseline::Manifest.new(root: File.expand_path("..", __dir__)).verify!(execution: ARGV == ["bootstrap"])
  if ARGV == ["verify"]
    puts JSON.pretty_generate(baseline_id: manifest.data.fetch("baseline_id"), verified: true, versions: manifest.versions)
    exit
  end
  abort "Refusing baseline: inherited SCHEMA is not accepted" if ENV.key?("SCHEMA")
  abort "Refusing baseline: inherited environment must be test" if %w[RAILS_ENV RACK_ENV].any? { |key| ENV.key?(key) && ENV[key] != "test" }
  ENV["RAILS_ENV"] = ENV["RACK_ENV"] = "test"
  require_relative "../lib/isolated_test_database"
  require_relative "../lib/arena_baseline/destination"
  PG.connect(ENV.fetch("APP_MUSIC_TEST_DATABASE_URL")) do |connection|
    ArenaBaseline::Destination.verify_empty!(rows: ->(sql) { connection.exec(sql).values })
  end
  ENV["DATABASE_URL"] = ENV.fetch("APP_MUSIC_TEST_DATABASE_URL")
  ENV["PARALLEL_WORKERS"] = "1"
  require_relative "../config/environment"
  require_relative "../lib/arena_baseline/bootstrap"
  puts JSON.pretty_generate(ArenaBaseline::Bootstrap.call(manifest:))
rescue ArenaBaseline::InvalidManifest => error
  abort "Refusing baseline: #{error.message}"
rescue StandardError => error
  warn "Baseline failed (#{error.class}); inspect private logs and destination state"
  exit 1
end
