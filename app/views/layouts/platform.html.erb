<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · AppMusic" : "AppMusic · Seu espaço de prática" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if controller_path.start_with?("arena/") %><meta name="turbo-cache-control" content="no-cache"><% end %>
    <%= render "shared/theme_boot" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/fonts" %>
    <script src="https://unpkg.com/tone@14.8.49/build/Tone.js" data-turbo-track="reload"></script>
    <script src="https://unpkg.com/soundfont-player@0.12.0/dist/soundfont-player.min.js" data-turbo-track="reload"></script>
  </head>
  <body class="platform-ui app-body <%= 'study-editorial' if editorial_study_screen? %> <%= 'exercise-workbench' if controller_name == "student_hub" && action_name == "playground" %>" data-controller="theme" data-action="turbo:before-render@document->theme#apply">
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    <div class="app-shell <%= 'has-playground' if controller_name == 'student_hub' && action_name == 'playground' %>"
         data-controller="app-shell" data-app-shell-storage-key-value="app_music_sidebar_collapsed"
         data-action="keydown@window->app-shell#keydown turbo:before-cache@document->app-shell#beforeCache">
      <%= render "platform/side_nav" %>
      <button type="button" class="app-backdrop" tabindex="-1" aria-label="Fechar menu" data-action="app-shell#close"></button>
      <div class="app-workspace" data-app-shell-target="workspace">
        <%= render "platform/top_nav" %>
        <%= render "shared/flash" %>
        <main id="main-content" class="app-main" tabindex="-1"><%= yield %></main>
        <footer class="app-footer">AppMusic <span aria-hidden="true">·</span> Um pouco de música, todos os dias.</footer>
      </div>
    </div>
  </body>
</html>
