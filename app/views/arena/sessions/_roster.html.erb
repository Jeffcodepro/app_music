<section class="arena-card arena-roster"><div class="arena-section-heading"><div><p class="arena-eyebrow">A banda está se formando</p><h2>Quem está no palco</h2></div><span><%= state[:participant_count] %> / <%= state[:capacity] %> jogadores</span></div>
  <% if state[:roster]&.any? %><ul><% state[:roster].each do |member| %><li data-arena-member-key="<%= member[:key] %>" data-arena-member-name="<%= member[:nickname] %>"><%= render "arena/shared/avatar", avatar_id: member[:avatar_id] %><div class="arena-roster-name"><strong><%= member[:nickname] %><%= " · Você" if member[:you] %></strong><span>Pronto para jogar</span></div>
    <% if member[:removable] %><details class="arena-remove-member" data-arena-member-controls="<%= member[:key] %>"><summary aria-label="Remover <%= member[:nickname] %>" title="Remover da sala"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span class="visually-hidden">Remover <%= member[:nickname] %></span></summary><div><p>Retirar <strong><%= member[:nickname] %></strong>? A pessoa não poderá voltar pelo convite.</p><div class="arena-actions"><button type="button" class="arena-button" data-action="arena-live#cancelDisclosure">Manter</button><%= button_to "Confirmar remoção", remove_member_app_arena_session_path(state[:id], member[:id]), params: { version: state[:version] }, class: "arena-button arena-button--danger", data: { arena_remove: member[:key] } %></div></div></details><% end %>
  </li><% end %></ul><% else %><p>Compartilhe o convite para reunir sua turma.</p><% end %>
  <% if state[:host] %><p class="arena-hint">Todos aqui já confirmaram personagem e apelido. Mantenha a turma ou remova alguém antes de iniciar.</p><% end %>
</section>
