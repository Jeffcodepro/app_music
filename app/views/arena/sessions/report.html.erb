<% content_for :title, "Relatório · #{@report[:title]}" %>
<section class="arena arena-report">
  <header class="arena-heading arena-heading--room"><div><%= link_to "← Voltar ao resultado", app_arena_session_path(@room), class: "arena-back" %><p class="arena-eyebrow">Olhar do anfitrião</p><h1><%= @report[:title] %></h1><p>Resultados observados nesta partida.</p></div><%= link_to "Baixar CSV ↓", report_app_arena_session_path(@room, format: :csv), class: "arena-button" %></header>
  <div class="arena-report-summary"><div><strong><%= @report[:players].size %></strong><span>participantes</span></div><div><strong><%= @report[:valid_count] %></strong><span>questões válidas</span></div><div><strong><%= @report[:players].sum { |player| player[:correct] } %></strong><span>respostas corretas</span></div><div><strong><%= @report[:void_count] %></strong><span>questões fora do resultado</span></div></div>
  <p class="arena-report-note">Ausência de resposta não significa desconhecimento. Quem saiu preserva seus pontos; questões posteriores à saída podem aparecer sem resposta. Este relatório descreve a partida e ajuda a planejar a próxima explicação.</p>
  <section aria-labelledby="arena-group-review"><div class="arena-section-heading"><h2 id="arena-group-review">O que retomar com a turma</h2><span>Erros entre respostas enviadas</span></div><div class="arena-report-questions">
    <% @report[:questions].sort_by { |question| [-question[:incorrect],question[:position]] }.each do |question| %>
      <details class="arena-card arena-question-review"><summary><span class="arena-question-number"><%= question[:position] %></span><span><strong><%= question[:topic] %></strong><small><%= question[:level] %> · <%= question[:clef] %></small></span><span class="arena-question-outcome"><strong><%= question[:incorrect] %> / <%= question[:responses] %></strong> erros <span aria-hidden="true">⌄</span></span></summary><div><p><%= question[:prompt] %></p><div class="arena-score"><%= question[:svg]&.html_safe %></div><p>Resposta: <strong><%= question[:correct_label] %></strong></p></div></details>
    <% end %>
    <% if @report[:questions].empty? %><p>Nenhuma questão foi concluída nesta sala.</p><% end %>
  </div></section>
  <section aria-labelledby="arena-player-review"><div class="arena-section-heading"><h2 id="arena-player-review">Cada pessoa, seu percurso</h2><span>Abra um participante para ver os detalhes</span></div><div class="arena-player-reviews">
    <% @report[:players].each do |player| %>
      <details class="arena-card arena-player-review"><summary><%= render "arena/shared/avatar", avatar_id: player[:avatar_id] %><span><strong><%= player[:nickname] %></strong><small><%= player[:status] == "left" ? "Saiu · pontos preservados" : (player[:status] == "removed" ? "Histórico preservado" : "Participou da partida") %></small></span><span class="arena-review-score"><strong><%= player[:points] %></strong><small>pontos · <%= player[:place] ? "#{player[:place]}º" : "Não classificado" %></small></span><span aria-hidden="true">⌄</span></summary><div class="arena-player-review-body">
        <div class="arena-player-metrics"><span><strong><%= player[:correct] %></strong> acertos</span><span><strong><%= player[:incorrect] %></strong> erros enviados</span><span><strong><%= player[:unanswered] %></strong> sem resposta</span><span><strong><%= player[:technical] %></strong> escutas não avaliadas</span><span><strong><%= player[:mean_elapsed_ms] ? "#{number_with_precision(player[:mean_elapsed_ms] / 1000.0, precision: 1)}s" : "—" %></strong> tempo ativo médio</span></div>
        <ul class="arena-topic-observations"><% player[:topics].each do |topic| %><li><span><%= topic[:topic] %> · <%= topic[:level] %> · <%= topic[:clef] %></span><strong><%= topic[:correct] %> / <%= topic[:total] %> acertos</strong></li><% end %></ul>
        <div class="arena-table-scroll"><table><caption class="visually-hidden">Respostas de <%= player[:nickname] %></caption><thead><tr><th>Questão</th><th>Resultado</th><th>Resposta enviada</th><th>Resposta correta</th><th>Tempo ativo</th></tr></thead><tbody><% player[:questions].each do |question| %><tr><th scope="row"><%= question[:position] %> · <%= question[:topic] %></th><td><%= Arena::Report::OUTCOMES.fetch(question[:outcome]) %></td><td><%= question[:selected_label] || "—" %></td><td><%= question[:correct_label] %></td><td><%= question[:elapsed_ms] ? "#{number_with_precision(question[:elapsed_ms] / 1000.0, precision: 1)}s" : "—" %></td></tr><% end %></tbody></table></div>
      </div></details>
    <% end %>
  </div></section>
  <p class="arena-hint">O tempo ativo inclui a entrega da resposta ao servidor e exclui pausas. Partidas antigas podem não ter essa medição. Questões anuladas não entram nos acertos, erros ou ausências.</p>
</section>
