<section class="auth-panel">
  <%= render "platform/page_header", title: "Bom ter você aqui", description: "Entre para continuar sua prática musical." %>
  <div class="ui-card">
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.input :email, required: true, autofocus: true, input_html: { autocomplete: "email" }, label: "E-mail" %>
      <%= f.input :password, required: true, input_html: { autocomplete: "current-password" }, label: "Senha" %>
      <%= f.input :remember_me, as: :boolean, label: "Manter conectado" if devise_mapping.rememberable? %>
      <%= f.button :submit, "Entrar", class: "app-btn app-btn--primary" %>
    <% end %>
    <%= render "devise/shared/providers" %>
    <%= render "devise/shared/links" %>
  </div>
</section>
