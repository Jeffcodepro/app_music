<section class="auth-panel">
  <%= render "platform/page_header", title: "Sua música começa aqui", description: "Crie sua conta no AppMusic." %>
  <div class="ui-card">
    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= f.error_notification %>
      <%= f.input :full_name, required: true, autofocus: true, label: "Nome completo", input_html: { autocomplete: "name" } %>
      <%= f.input :phone, label: "Telefone", input_html: { autocomplete: "tel" } %>
      <%= f.input :email, required: true, label: "E-mail", input_html: { autocomplete: "email" } %>
      <%= f.input :password, required: true, label: "Senha", hint: (@minimum_password_length ? "Mínimo de #{@minimum_password_length} caracteres" : nil), input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation, required: true, label: "Confirmar senha", input_html: { autocomplete: "new-password" } %>
      <%= f.button :submit, "Criar cadastro", class: "app-btn app-btn--primary" %>
    <% end %>
    <%= render "devise/shared/providers" %><%= render "devise/shared/links" %>
  </div>
</section>
