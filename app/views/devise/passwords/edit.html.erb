<section class="auth-panel">
  <%= render "platform/page_header", title: "Escolha uma nova senha" %>
  <div class="ui-card">
    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.error_notification %><%= f.input :reset_password_token, as: :hidden %><%= f.full_error :reset_password_token %>
      <%= f.input :password, required: true, autofocus: true, label: "Nova senha", hint: ("Mínimo de #{@minimum_password_length} caracteres" if @minimum_password_length), input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation, required: true, label: "Confirmar nova senha", input_html: { autocomplete: "new-password" } %>
      <%= f.button :submit, "Salvar nova senha", class: "app-btn app-btn--primary" %>
    <% end %><%= render "devise/shared/links" %>
  </div>
</section>
