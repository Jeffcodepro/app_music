<section class="auth-panel">
  <%= render "platform/page_header", title: "Recuperar sua senha", description: "Informe o e-mail da sua conta para solicitar as instruções de recuperação." %>
  <div class="ui-card">
    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= f.error_notification %>
      <%= f.input :email, required: true, autofocus: true, label: "E-mail", input_html: { autocomplete: "email" } %>
      <%= f.button :submit, "Solicitar instruções", class: "app-btn app-btn--primary" %>
    <% end %><%= render "devise/shared/links" %>
  </div>
</section>
