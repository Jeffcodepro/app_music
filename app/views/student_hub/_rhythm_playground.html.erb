<%= turbo_frame_tag "rhythm_playground" do %>
  <article class="platform-card playground-stage"
           data-controller="rhythm-player preferences"
           <% if rhythm_exercise[:rhythm_format] == "meter-v1" %>
             data-rhythm-player-meter-value="<%= rhythm_exercise[:meter].to_json %>"
             data-rhythm-player-measure-count-value="<%= rhythm_exercise[:measure_count] %>"
             data-rhythm-player-total-steps-value="<%= rhythm_exercise[:total_steps] %>"
           <% end %>
           data-rhythm-player-events-value="<%= rhythm_exercise[:audio_events].to_json %>"
           data-rhythm-player-tempo-bpm-value="<%= rhythm_exercise[:tempo_bpm] %>"
           data-rhythm-player-count-in-beats-value="<%= rhythm_exercise[:count_in_beats] %>"
           data-rhythm-player-exercise-signature-value="<%= rhythm_exercise[:assignment_id] %>"
           data-rhythm-player-metronome-during-pattern-value="<%= rhythm_exercise[:metronome_during_pattern] %>"
           data-rhythm-player-playback-cycles-value="<%= rhythm_exercise[:playback_cycles] %>">
    <% feedback_for_current_round = feedback_for_round?(playground_feedback, rhythm_exercise, area: "ritmica") %>
    <% answered_correctly = feedback_for_current_round && playground_feedback[:correct] %>
    <%= render "student_hub/previous_round_result" if completed_previous_round?(playground_feedback, rhythm_exercise, area: "ritmica") %>

    <div class="playground-scoreboard">
      <div class="playground-scoreboard__item is-correct">
        <span class="playground-scoreboard__label">Acertos</span>
        <strong><%= rhythm_scoreboard[:correct_count] %></strong>
      </div>
      <div class="playground-scoreboard__item is-incorrect">
        <span class="playground-scoreboard__label">Erros</span>
        <strong><%= rhythm_scoreboard[:incorrect_count] %></strong>
      </div>
    </div>

    <details class="playground-settings" data-preferences-target="panel"
             data-action="toggle->preferences#rememberExpanded" data-preferences-key="ritmica">
      <summary>Configurar treino <span><%= rhythm_exercise[:activity_mode_label] %></span></summary>
    <%= form_with url: app_playground_path, method: :get, class: "playground-controls playground-controls--stacked", data: { turbo_frame: "rhythm_playground", turbo_action: "replace", preferences_target: "form" } do %>
      <%= hidden_field_tag :activity, "ritmica" %>
      <div class="rhythm-meter-controls">
        <div class="playground-control">
          <%= label_tag :level, "Nível de dificuldade", class: "playground-control__label" %>
          <%= select_tag :level, options_for_select((1..4).map { |n| ["Nível #{n}", n] }, rhythm_preferences[:level] || 1), data: { action: "change->rhythm-player#stop change->preferences#submit" } %>
        </div>
        <div class="playground-control">
          <%= label_tag :meter_id, "Compasso", class: "playground-control__label" %>
          <%= select_tag :meter_id, options_for_select([["Misto · sortear a cada exercício", "mixed"]] + MusicTheory::Meter.presets(level: rhythm_preferences[:level] || 1).map { |preset| [MusicTheory::Meter.fetch(preset[:id]).option_label, preset[:id]] }, rhythm_preferences[:meter_id] || "4-4"), data: { action: "change->rhythm-player#stop change->preferences#submit" } %>
        </div>
      </div>
      <p class="rhythm-level-hint">1: divisões regulares · 2: combinações · 3: subdivisões finas · 4: maior variedade e pausas. Em Pulso, o foco continua na pulsação.</p>


      <div class="playground-control">
        <span class="playground-control__label">Tipo de atividade</span>
        <div class="playground-direction-grid">
          <% rhythm_activity_modes.each do |mode| %>
            <% checked = rhythm_preferences[:activity_mode] == mode[:id] %>
            <label class="playground-direction-card <%= 'is-selected' if checked %>">
              <%= radio_button_tag :activity_mode, mode[:id], checked, class: "playground-direction-card__input", data: { action: "change->rhythm-player#stop change->preferences#submit" } %>
              <span class="playground-direction-card__title"><%= mode[:label] %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    </details>

    <div class="playground-stage__grid">
      <div class="playground-trainer">
        <h2 class="exercise-question">Qual partitura você ouviu?</h2>
        <p class="exercise-context"><%= rhythm_exercise[:time_signature_label] %> · <%= "#{rhythm_exercise[:bpm_unit_label]} = " if rhythm_exercise[:bpm_unit_label] %><%= rhythm_exercise[:tempo_bpm] %> BPM · <%= rhythm_exercise[:activity_mode_label] %><% if rhythm_exercise[:meter]&.dig(:kind) == "additive" %> · <%= rhythm_exercise[:meter][:groups].join("+") %><% end %><% if rhythm_exercise[:measure_count] == 2 %> · 2 compassos<% end %></p>
        <section class="harmony-player-panel" aria-label="Áudio do ditado rítmico">
          <div class="harmony-player-grid">
            <button type="button"
                    class="harmony-listen-button harmony-listen-button--linear"
                    aria-label="Tocar ditado rítmico"
                    data-action="rhythm-player#play"
                    data-rhythm-player-target="trigger">
              <span class="app-btn__icon"><%= interface_symbol_icon("play") %></span>
              <span class="harmony-listen-button__title">Tocar</span>
            </button>
            <button type="button"
                    class="harmony-transport-button"
                    data-action="rhythm-player#repeat"
                    data-rhythm-player-target="trigger"
                    aria-label="Repetir a última escuta">
              <span class="app-btn__icon"><%= interface_symbol_icon("restart") %></span>
              <span class="harmony-transport-button__label">Repetir</span>
            </button>

            <%= render "student_hub/audio_status", player: "rhythm" %>


          </div>
        </section>
      </div>

      <div class="playground-response-panel">
        <h3 class="visually-hidden">Partituras alternativas</h3>
        <div class="perception-options rhythm-options <%= 'metrical-options' if rhythm_exercise[:rhythm_format] %>">
          <% rhythm_exercise[:options].each_with_index do |option, index| %>
            <% metrical = rhythm_exercise[:rhythm_format] == "meter-v1" %>
            <% if metrical %>
              <div class="metrical-answer">
                <div class="rhythm-notation-card rhythm-score-scroll" tabindex="0" role="region" aria-label="Partitura <%= index+1 %>. Use as setas para percorrer.">
            <% end %>
            <%= button_to submit_app_playground_answer_path,
                          method: :post,
                          params: {
                            activity: "ritmica",
                            selected_option_id: option[:id],
                            assignment_id: rhythm_exercise[:assignment_id],
                            attempt_token: rhythm_exercise[:attempt_token],
                            playback_status: "",
                            **rhythm_preferences
                          },
                          class: "perception-option rhythm-option",
                          aria: { label: "Responder com partitura #{index+1}" },
                          disabled: answered_correctly,
                          data: { action: "click->rhythm-player#guardAnswer" },
                          form: { data: { turbo_frame: "rhythm_playground" } } do %>
              <span class="<%= 'rhythm-notation-card' unless metrical %>"><%= rhythm_staff_svg(option[:pattern_signature], exercise: rhythm_exercise) %></span>
            <% end %>
            <% if metrical %></div></div><% end %>
          <% end %>
        </div>
      <% if feedback_for_current_round %>
        <div role="status" aria-live="polite" aria-atomic="true" class="playground-feedback <%= playground_feedback[:correct] ? 'is-correct' : 'is-incorrect' %>" data-rhythm-player-target="feedback">
          <p class="playground-eyebrow">Última resposta</p>
          <% if playground_feedback[:synchronization_error] %>
            <h3>Ouça novamente a rodada atual</h3>
            <p>A escuta mais recente não correspondia a este exercício. Reproduza o padrão atual antes de responder.</p>
          <% elsif playground_feedback[:correct] %>
            <h3>Resposta correta</h3>
            <p>Você reconheceu corretamente o padrão de <strong><%= playground_feedback[:activity_mode_label] %></strong>.</p>
            <p class="muted">Rodada: <strong><%= playground_feedback[:tempo_label] %></strong>.</p>
          <% else %>
            <h3>Resposta incorreta</h3>
            <p>Reproduza novamente o trecho para comparar o pulso, a subdivisão e a posição exata dos ataques.</p>
          <% end %>
        </div>
      <% end %>

      <div class="playground-next">
        <%= link_to app_playground_path(activity: "ritmica", refresh: 1, **rhythm_preferences),
                          class: "playground-next-button",
                          data: { turbo_frame: "rhythm_playground" },
                          aria: { label: "Próximo exercício" } do %>
                <span class="app-btn__icon"><%= interface_symbol_icon("next") %></span>
              <span>Próximo exercício</span>
            <% end %>
      </div>
      </div>
    </div>
  </article>
<% end %>
