<% attempts = platform_attempts(current_user) %>
<%= render "platform/page_header", eyebrow: "Seu percurso", title: "Histórico de prática", description: "Suas respostas registradas nos Playgrounds, em todas as sessões." %>
<section class="history-totals" aria-label="Todas as respostas da sua conta">
  <div><strong><%= attempts.count %></strong><span>Respostas registradas</span></div>
  <div><strong data-testid="correct-count"><%= attempts.where(correct: true).count %></strong><span>Corretas</span></div>
  <div><strong><%= attempts.where(correct: false).count %></strong><span>Incorretas</span></div>
  <p>Totais de todas as respostas. A lista abaixo mostra até 50 registros recentes.</p>
</section>
<section class="history-entries" aria-labelledby="history-entries-title">
  <div class="section-heading"><h2 id="history-entries-title">Últimas 50 respostas</h2><%= link_to "Continuar praticando", app_pratica_path, class: "ui-text-link" %></div>
  <%= render "platform/history", attempts: attempts.includes(:exercise_assignment).order(created_at: :desc, id: :desc).limit(50) %>
</section>
