<aside id="platform-sidebar" class="app-sidebar" aria-label="Menu AppMusic" data-app-shell-target="sidebar">
  <div class="app-sidebar__brand">
    <%= link_to app_dashboard_path, class: "app-logo", aria: { label: "AppMusic — início" } do %>
      <span class="app-logo__mark"><%= ui_icon("music") %></span><span class="nav-label">AppMusic</span>
    <% end %>
    <span data-app-shell-target="toggleSlot"></span>
  </div>
  <p class="nav-caption nav-label">Seu espaço de estudo</p>
  <nav class="app-side-menu" aria-label="Navegação principal" data-action="click->app-shell#navigate">
    <% platform_navigation.reject { |item| item[:preparing] || item[:section] == "account" }.each do |item| %>
      <% active = platform_section == item[:section] %>
      <%= link_to public_send(item[:route]), class: "app-side-item #{'is-active' if active}", aria: { current: active ? "page" : nil, label: item[:label] }, title: item[:label] do %>
        <%= ui_icon(item[:icon]) %><span class="nav-label"><%= item[:label] %></span>
      <% end %>
    <% end %>
  </nav>
  <p class="nav-caption nav-label nav-caption--future">Em preparação</p>
  <nav class="app-side-menu" aria-label="Em preparação" data-action="click->app-shell#navigate">
    <% platform_navigation.select { |item| item[:preparing] }.each do |item| %>
      <% active = platform_section == item[:section] %>
      <%= link_to public_send(item[:route]), class: "app-side-item #{'is-active' if active}", aria: { current: active ? "page" : nil, label: item[:label] }, title: "#{item[:label]} — em preparação" do %>
        <%= ui_icon(item[:icon]) %><span class="nav-label"><%= item[:label] %></span>
      <% end %>
    <% end %>
  </nav>
  <div class="sidebar-bottom">
    <details class="account-menu" data-controller="account-menu" data-action="toggle->account-menu#sync keydown.esc->account-menu#escape click@window->account-menu#outside resize@window->account-menu#viewportChanged turbo:before-cache@document->account-menu#beforeCache">
      <summary class="sidebar-account <%= 'is-active' if platform_section == 'account' %>" data-account-menu-target="summary" aria-expanded="false" aria-label="Menu da conta — <%= current_user.full_name.presence || 'Estudante' %>" aria-controls="account-menu-panel">
        <%= user_avatar(current_user, css_class: "app-avatar") %>
        <span class="sidebar-account__text nav-label"><strong><%= current_user.full_name.presence || 'Estudante' %></strong><span>Minha conta</span></span>
        <span class="sidebar-account__arrow nav-label" aria-hidden="true">⌃<br>⌄</span>
      </summary>
      <div id="account-menu-panel" class="account-menu__panel" data-account-menu-target="panel" data-action="click->account-menu#navigate click->app-shell#navigate">
        <div class="account-menu__identity"><%= user_avatar(current_user, css_class: "app-avatar") %><div><strong><%= current_user.full_name %></strong><span><%= current_user.email %></span></div></div>
        <%= link_to app_dashboard_path do %><%= ui_icon("home") %><span>Painel do membro</span><% end %>
        <%= link_to app_perfil_path do %><%= ui_icon("settings") %><span>Configurações</span><% end %>
        <%= button_to destroy_user_session_path, method: :delete, aria: { label: "Sair da conta" } do %><%= ui_icon("logout") %><span>Sair</span><% end %>
      </div>
    </details>
  </div>
</aside>
