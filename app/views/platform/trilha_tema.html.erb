<%= link_to "← Trilhas de estudo", app_trilhas_path, class: "ui-text-link" %>
<%= render "platform/page_header", title: @study_track_theme[:title], description: "Disponibilidade de estudo nesta área." %>
<% activity = playground_activity_for(@study_track_theme[:slug]) %>
<% if activity %>
  <section class="ui-card"><span class="ui-status">Prática disponível</span><h2><%= activity[:title] %></h2><p><%= activity[:description] %></p><p class="ui-support">A sequência de aulas e a avaliação por nível ainda estão em preparação.</p><div class="platform-actions"><%= link_to "Abrir Playground", app_playground_path(activity: activity[:slug]), class: "app-btn app-btn--primary" %></div></section>
<% else %>
  <%= render "platform/empty_state", title: "Conteúdo em preparação", description: "Ainda não há aulas ou exercícios publicados nesta área. Enquanto isso, explore as práticas disponíveis." %>
<% end %>
