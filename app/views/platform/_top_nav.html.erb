<header class="app-topbar">
  <div class="app-topbar__location">
    <button type="button" class="ui-icon-button sidebar-toggle" data-sidebar-panel-icon data-action="app-shell#toggle" data-app-shell-target="toggle" aria-controls="platform-sidebar" aria-expanded="false" aria-label="Abrir ou recolher menu"><%= ui_icon("sidebar") %></button>
    <span class="app-topbar__section"><%= platform_section_label %></span>
  </div>
  <div class="app-topbar__actions">
    <%= render "shared/theme_control", icon_only: true %>
  </div>
</header>
