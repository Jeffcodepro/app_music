<%= render "platform/page_header", title: "Minha conta", description: "Seus dados, acesso e preferências." %>
<div class="account-layout" data-account-section="overview">
  <%= render "platform/account_navigation" %>
  <div class="account-content">
    <section class="ui-card account-panel account-overview"><%= user_avatar(current_user, css_class: "account-avatar-preview") %><div><h2><%= current_user.full_name %></h2><p><%= current_user.email %></p></div><%= link_to "Editar perfil", app_account_personal_path, class: "app-btn" %></section>
    <div class="account-overview-grid">
      <section class="ui-card account-panel"><%= ui_icon("monitor") %><h2>Assinaturas e compras</h2><p>Plano registrado: <strong><%= current_user.plan.presence || "Não selecionado" %></strong></p><%= link_to "Consultar plano", app_account_subscription_path, class: "ui-text-link" %></section>
      <section class="ui-card account-panel"><%= ui_icon("key") %><h2>Dados de acesso</h2><p>Gerencie seu e-mail e sua senha.</p><%= link_to "Gerenciar acesso", edit_user_registration_path, class: "ui-text-link" %></section>
      <section class="ui-card account-panel"><%= ui_icon("bell") %><h2>Notificações</h2><p>Consulte os avisos disponíveis.</p><%= link_to "Ver notificações", app_account_notifications_path, class: "ui-text-link" %></section>
      <section class="ui-card account-panel"><%= ui_icon("sun") %><h2>Aparência</h2><p>Seu tema preferido para estudar.</p><%= link_to "Configurar aparência", app_account_appearance_path, class: "ui-text-link" %></section>
    </div>
  </div>
</div>
