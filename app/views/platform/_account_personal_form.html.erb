<section class="ui-card account-panel">
  <h2>Dados pessoais</h2><p>Seu perfil e seus objetivos de estudo.</p>
  <% if current_user.errors.any? %><div class="ui-errors" role="alert"><h3>Revise os dados abaixo</h3><ul><% current_user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <%= form_with model: current_user, url: update_app_perfil_path, method: :patch do |f| %>
    <div class="account-avatar-row"><%= user_avatar(current_user, css_class: "account-avatar-preview") %><div><%= f.label :avatar, "Foto de perfil", class: "account-label" %><%= f.file_field :avatar, accept: "image/*", class: "platform-input" %></div></div>
    <div class="account-form-grid">
      <div><%= f.label :full_name, "Nome completo", class: "account-label" %><%= f.text_field :full_name, class: "platform-input", required: true, autocomplete: "name" %></div>
      <div><%= f.label :phone, "Telefone", class: "account-label" %><%= f.telephone_field :phone, class: "platform-input", autocomplete: "tel" %></div>
      <div><%= f.label :primary_instrument, "Instrumento principal", class: "account-label" %><%= f.text_field :primary_instrument, class: "platform-input" %></div>
      <div><%= f.label :study_goal, "Objetivo de estudo", class: "account-label" %><%= f.text_field :study_goal, class: "platform-input" %></div>
    </div>
    <div class="platform-actions"><%= f.submit "Salvar alterações", class: "app-btn app-btn--primary" %></div>
  <% end %>
</section>
