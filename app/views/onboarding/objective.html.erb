<%= render "platform/page_header", title: "O que você quer estudar?", description: "Sua escolha ficará na configuração inicial desta sessão." %>
<section class="ui-card">
  <%= form_with url: update_onboarding_objective_path, method: :patch, class: "ui-form" do |f| %>
    <fieldset><legend>Escolha um objetivo</legend>
      <% ["aprender teoria do zero", "melhorar leitura", "treinar percepção", "desenvolver ritmo", "aprofundar harmonia", "estudar no próprio ritmo"].each do |option| %>
        <label class="platform-option"><%= f.radio_button :objective, option, checked: session[:onboarding_objective] == option, required: true %><span><%= option.capitalize %></span></label>
      <% end %>
    </fieldset><div><%= f.submit "Continuar", class: "app-btn app-btn--primary" %></div>
  <% end %>
</section>
