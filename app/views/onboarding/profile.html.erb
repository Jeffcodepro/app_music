<%= render "platform/page_header", title: "Sua rotina musical", description: "Essas preferências ficam nesta sessão. Para salvar os dados da conta, use Minha conta." %>
<section class="ui-card">
  <% initial = session[:onboarding_profile] || {} %>
  <%= form_with url: update_onboarding_profile_path, method: :patch, class: "ui-form" do |f| %>
    <div><%= f.label :display_name, "Como prefere ser chamado?", class: "account-label" %><%= f.text_field :display_name, value: initial["display_name"], class: "platform-input", autocomplete: "given-name" %></div>
    <div><%= f.label :instrument, "Instrumento principal (opcional)", class: "account-label" %><%= f.text_field :instrument, value: initial["instrument"], class: "platform-input" %></div>
    <div><%= f.label :study_availability, "Disponibilidade de estudo", class: "account-label" %><%= f.select :study_availability, [["15 min/dia", "15 min/dia"], ["30 min/dia", "30 min/dia"], ["45+ min/dia", "45+ min/dia"]], { selected: initial["study_availability"] }, { class: "platform-input" } %></div>
    <div><%= f.submit "Revisar preferências", class: "app-btn app-btn--primary" %></div>
  <% end %>
</section>
