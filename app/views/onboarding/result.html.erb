<%= render "platform/page_header", title: "Suas preferências iniciais", description: "Um ponto de partida para escolher sua prática. Nenhum nível musical foi atribuído." %>
<% profile = session[:onboarding_profile] || {} %>
<section class="ui-card"><h2>O que você escolheu nesta sessão</h2><dl class="preference-review"><dt>Objetivo</dt><dd><%= session[:onboarding_objective].presence || "Não informado" %></dd><dt>Instrumento</dt><dd><%= profile["instrument"].presence || "Não informado" %></dd><dt>Disponibilidade</dt><dd><%= profile["study_availability"].presence || "Não informada" %></dd></dl><div class="platform-actions"><%= link_to "Escolher uma prática", app_pratica_path, class: "app-btn app-btn--primary" %><%= link_to "Editar preferências", onboarding_objective_path, class: "app-btn" %></div></section>
